# Terraform state files (contain sensitive information, never commit)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform directories
.terraform/
.terraform.lock.hcl

# Variable files (may contain sensitive configuration)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Crash logs
crash.log
crash.*.log

# Ignore kubeconfig files
kubeconfig
kubeconfig_*

# Local environment variables
.env
.env.local

# IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Backup files
*.bak
